{
  "name": "@scitex/ui",
  "private": true,
  "version": "0.1.0",
  "description": "Shared React UI components for the SciTeX ecosystem",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywatanabe1989/scitex-ui.git"
  },
  "homepage": "https://github.com/ywatanabe1989/scitex-ui#readme",
  "bugs": {
    "url": "https://github.com/ywatanabe1989/scitex-ui/issues"
  },
  "main": "src/scitex_ui/static/scitex_ui/react/index.ts",
  "types": "src/scitex_ui/static/scitex_ui/react/index.ts",
  "exports": {
    ".": "./src/scitex_ui/static/scitex_ui/react/index.ts",
    "./react": "./src/scitex_ui/static/scitex_ui/react/index.ts",
    "./react/*": "./src/scitex_ui/static/scitex_ui/react/*",
    "./pdf-viewer": "./src/scitex_ui/static/scitex_ui/ts/app/pdf-viewer/index.ts",
    "./pdf-viewer/react": "./src/scitex_ui/static/scitex_ui/react/app/pdf-viewer/index.ts",
    "./monaco-editor": "./src/scitex_ui/static/scitex_ui/ts/app/monaco-editor/index.ts",
    "./css/*": "./src/scitex_ui/static/scitex_ui/css/*",
    "./ts": "./src/scitex_ui/static/scitex_ui/ts/index.ts",
    "./ts/shell": "./src/scitex_ui/static/scitex_ui/ts/shell/index.ts",
    "./ts/app": "./src/scitex_ui/static/scitex_ui/ts/app/index.ts",
    "./ts/*": "./src/scitex_ui/static/scitex_ui/ts/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/scitex_ui/static/scitex_ui/react/**/*.ts",
    "src/scitex_ui/static/scitex_ui/react/**/*.tsx",
    "src/scitex_ui/static/scitex_ui/ts/**/*.ts",
    "src/scitex_ui/static/scitex_ui/ts/**/*.tsx",
    "src/scitex_ui/static/scitex_ui/js/**/*.js",
    "src/scitex_ui/static/scitex_ui/css/**/*.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.6.0",
    "mermaid": "^11.0.0",
    "pdfjs-dist": "^4.10.38"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.45.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "monaco-editor": "^0.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
